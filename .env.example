# Discord app: https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must exactly match a redirect registered in the Discord app's OAuth2 settings
DISCORD_REDIRECT_URI=https://yourdomain.vercel.app/api/auth/callback

# The server whose roles gate dashboard access
DISCORD_GUILD_ID=
# Only users with this role id in that guild can log into the dashboard
DISCORD_ALLOWED_ROLE_ID=

# Random long string, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# Supabase project settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
